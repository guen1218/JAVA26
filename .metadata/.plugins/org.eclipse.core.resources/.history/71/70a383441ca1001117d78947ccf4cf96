package grammar;

public class Star03 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int num = 5;
		for(int i=num; i>0; i--) {
			for(int j=0; j<i; j++) {
				System.out.print(" ");
			}
			for(int j=i; j<num; j++) {
				System.out.print("*");
			}
			System.out.println();
		}
	}
	int num = 5;
	for(int i=0; i<num; i++) {
		for(int j=0; j<num; j++) {
			if(j>=i) {
				System.out.print("*");
			}else {
				System.out.print(" ");
			}
		}
		System.out.println();
	}
}
