package grammar;

public class Star06 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int num = 5;
		for(int i=0; i<num; i++) {
			for(int j=0; j<num; j++) {
				if(j>=i) {
					System.out.print("*");
				}else {
					System.out.print(" ");
				}
			}
			for(int j=num; j>i; j--) {
				System.out.print("*");
			}
			System.out.println();
		}
	}

}
